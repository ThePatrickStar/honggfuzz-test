{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ossfuzz",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/honggfuzz",
            "args": [
                "--persistent",
                "--threads",
                "1",
                "--rlimit_rss",
                "2048",
                "--sanitizers_del_report=true",
                "--input",
                "/out/seeds",
                "--output",
                "/out/corpus/corpus",
                "--crashdir",
                "/out/corpus/crashes",
                "--dict",
                "/out/ossfuzz.dict",
                "--",
                "/out/ossfuzz"
            ],
            "cwd": "/out"
        }
    ]
}